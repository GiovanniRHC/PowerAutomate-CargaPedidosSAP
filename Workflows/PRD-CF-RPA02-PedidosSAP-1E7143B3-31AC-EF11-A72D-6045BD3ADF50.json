        "Try_|_Ejecutar_Robot": {
          "actions": {
            "Ejecutar_Proceso_PEDIDOS_-_Atendido": {
              "runAfter": {},
              "limit": {
                "timeout": "PT5H30M"
              },
              "metadata": {
                "operationMetadataId": "2cd21f7e-60cb-4686-9469-102f8c7c714a"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_uiflow_1",
                  "operationId": "RunUIFlow_V2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_uiflow"
                },
                "parameters": {
                  "uiFlowId": "2594689f-09ac-ef11-8a69-002248def814",
                  "runMode": "attended"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Convert_time_zone_2": {
              "runAfter": {
                "Ejecutar_Proceso_PEDIDOS_-_Atendido": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "61c3800b-1f3c-4fc6-97aa-1470f104b903"
              },
              "type": "Expression",
              "kind": "ConvertTimeZone",
              "inputs": {
                "baseTime": "@{utcNow()}",
                "formatString": "f",
                "sourceTimeZone": "SA Pacific Standard Time",
                "destinationTimeZone": "SA Pacific Standard Time"
              }
            }
          },
          "runAfter": {
            "Inicializar_variable_|_Mensaje_de_Error": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "12361a80-89dd-4f3f-80df-e6c9903c311b"
          },
          "type": "Scope"
        },
        "Catch_|_Ejecutar_Robot": {
          "actions": {
            "Parse_JSON_|_Errores": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "d710c5c2-30e7-4f7e-b1c2-281038e5c732"
              },
              "type": "ParseJson",
              "inputs": {
                "content": "@result('Try_|_Ejecutar_Robot')",
                "schema": {
                  "type": "array"
                }
              }
            },
            "Apply_to_each": {
              "foreach": "@body('Parse_JSON_|_Errores')",
              "actions": {
                "Condition": {
                  "actions": {
                    "Set_variable": {
                      "runAfter": {},
                      "metadata": {
                        "operationMetadataId": "58af8dd3-74cd-415d-8837-42d0bc471515"
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "MensajeError",
                        "value": "@{if(equals(items('Apply_to_each')?['outputs']?['body']?['error']?['message'], null), items('Apply_to_each')?['error']?['message'], items('Apply_to_each')?['outputs']?['body']?['error']?['message'])}"
                      }
                    }
                  },
                  "runAfter": {},
                  "else": {
                    "actions": {
                      "Set_variable_2": {
                        "runAfter": {},
                        "metadata": {
                          "operationMetadataId": "58af8dd3-74cd-415d-8837-42d0bc471515"
                        },
                        "type": "SetVariable",
                        "inputs": {
                          "name": "MensajeError",
                          "value": "@{body('Parse_JSON_|_Errores')}"
                        }
                      }
                    }
                  },
                  "expression": {
                    "or": [
                      {
                        "equals": [
                          "@items('Apply_to_each')['status']",
                          "Failed"
                        ]
                      },
                      {
                        "equals": [
                          "@items('Apply_to_each')['status']",
                          "TimeOut"
                        ]
                      }
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "d424a8e3-8cbd-4441-8a75-c93368312892"
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Parse_JSON_|_Errores": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "f29735b1-e58a-4dda-961a-e881dc4d46fc"
              },
              "type": "Foreach"
            },
            "Redactar_|_Código_HTML_de_error_flujo_de_la_nube": {
              "runAfter": {
                "Apply_to_each": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e4458432-13de-4ad6-a3fd-d4dfaf83b7a4"
              },
              "type": "Compose",
              "inputs": "<table border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n    <tr>\n        <td>\n            <p style=\"border-top: solid 8px #E20A17; margin: 0px auto; width:100%;\">&nbsp;</p>\n        </td>\n    </tr>\n</table>\n\n<table border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n    <tr>\n        <td align=\"center\" style=\"padding: 20px 0px 0px 0px;\">\n            <p style=\"margin: 0px; color: #000000; font-size: 15px; line-height:32px; font-weight: bold;\">\n                CloudFlow - @{variables('NombreProceso')} | Error en la ejecución del robot\n            </p>\n        </td>\n    </tr>\n</table>\n\n<table border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n    <tr>\n        <td align=\"center\" style=\"padding: 15px;\">\n            <p style=\"margin: 10px 0; font-size: 14px; line-height: 22px; color: #797e82;\">\n                No fue posible iniciar la ejecución del robot debido a un problema de conectividad\n                o disponibilidad de la máquina virtual (PC/MV apagada o no accesible).\n            </p>\n\n            <p style=\"margin: 10px 0; font-size: 13px; line-height: 20px; color: #555555;\">\n                Detalle técnico:\n            </p>\n\n            <p style=\"margin: 0; font-size: 13px; line-height: 20px; color: #555555;\">\n                @{variables('MensajeError')}\n            </p>\n        </td>\n    </tr>\n</table>\n\n<p style=\"color: #6b7280; font-size: 13px; font-style: italic; text-align: center;\">\n    Este mensaje ha sido generado automáticamente por un proceso automatizado y no requiere respuesta.\n</p>\n\n<p style=\"text-align: center;\">\n    <strong>RPA | Orquestación</strong><br>\n    <strong>EMPRESADEMO</strong>\n</p>\n"
            },
            "Enviar_correo_electrónico_(V2)": {
              "runAfter": {
                "Redactar_|_Código_HTML_de_error_flujo_de_la_nube": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "4319096b-89bd-4af6-b07c-4165c56bde99"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365_1",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@variables('CorreoSoporte')",
                  "emailMessage/Subject": "Error de CloudFlow - @{variables('NombreProceso')} - @{body('Fecha_Hora_Local')}",
                  "emailMessage/Body": "@outputs('Redactar_|_Código_HTML_de_error_flujo_de_la_nube')",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Terminate": {
              "runAfter": {
                "HTTP": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "6d688a50-8121-4556-8b63-e7df9a3cffee"
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "Error @{variables('NombreProceso')}",
                  "message": "@{outputs('Redactar_|_Código_HTML_de_error_flujo_de_la_nube')}"
                }
              }
            },
            "HTTP": {
              "runAfter": {
                "Enviar_correo_electrónico_(V2)": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "39a98df0-046e-4c9c-80d7-53e66051011e"
              },
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@variables('TelegramMensajeAPI')",
                "body": {
                  "chat_id": "@{variables('TelegramSoporteChatEmergenciaID')}",
                  "text": "🚨 *Error Inesperado*\n\n📄 Detalle: @{variables('MensajeError')}\n\n⏱️ Reporte: @{body('Fecha_Hora_Local')}",
                  "parse_mode": "Markdown",
                  "disable_web_page_preview": true
                }
              }
            }
          },
          "runAfter": {
            "Try_|_Ejecutar_Robot": [
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "a40bda6f-d8d5-43bc-830c-c18d406fb79b"
          },
          "type": "Scope"
        },
