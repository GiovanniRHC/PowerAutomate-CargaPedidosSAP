          "type": "Expression",
          "kind": "ConvertTimeZone",
          "inputs": {
            "baseTime": "@{utcNow()}",
            "formatString": "g",
            "sourceTimeZone": "UTC",
            "destinationTimeZone": "SA Pacific Standard Time"
