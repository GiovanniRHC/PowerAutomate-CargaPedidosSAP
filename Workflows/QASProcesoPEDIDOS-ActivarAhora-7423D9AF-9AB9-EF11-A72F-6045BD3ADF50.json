              "type": "Compose",
              "inputs": "<!doctype html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\"\n    xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n\n<head>\n    <title></title>\n\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n</head>\n\n<body style=\"font-size:13px; font-family:Open Sans, Helvetica, Arial, sans-serif;\">\n\n    <div style=\"width: 600px; margin: 0px auto; background-color: #f8f8f8;\">\n        <br/>\n\n        <div style=\"width: 100%; margin: 0px auto; background-color: #ffffff;\">\n\n            <table border=\"0\" width=\"100%\" cellspacing=\"0\">\n                <tr>\n                    <td>\n                        <p style=\"border-top:solid 8px #E20A17; margin: 0px auto; width:100%;\">&nbsp;</p>\n                    </td>\n                </tr>\n            </table>\n\n            <table border=\"0\" width=\"100%\" cellspacing=\"0\">\n                <tr>\n                    <td align=\"center\" style=\"padding: 20px 0px 0px 0px;\">\n                        <p style=\"margin: 0px; color: #000000; font-size: 15px; line-height:32px; font-weight: bold;\">Ocurrió un error al ejecutar el robot</p>\n                    </td>\n                </tr>\n            </table>\n\n            <table border=\"0\" width=\"100%\" cellspacing=\"0\">\n                <tr>\n                    <td align=\"center\" style=\"padding: 10px;\">\n\n                        <p style=\"margin: 10px 0; font-size: 20px; line-height: 25px; color: #797e82;\">@{variables('MensajeError')}</p>\n\n                    </td>\n                </tr>\n            </table>\n        </div>\n        \n        <br/>\n    </div>\n\n</body>\n\n</html>"
            },
